# Скопируйте в .env.local (или .env) и заполните доступами курса / из спринта 2.
# copy .env.example .env.local

# Source Database / Общая БД (для итогого банка не обязательна)
DB_SOURCE_HOST=
DB_SOURCE_PORT=6432
DB_SOURCE_NAME=
DB_SOURCE_USER=
DB_SOURCE_PASSWORD=

# Destination Database / Личная БД — backend + Model Registry MLflow
DB_DESTINATION_HOST=
DB_DESTINATION_PORT=6432
DB_DESTINATION_NAME=
DB_DESTINATION_USER=
DB_DESTINATION_PASSWORD=

# Object Storage (S3) — хранилище артефактов MLflow
MLFLOW_S3_ENDPOINT_URL=https://storage.yandexcloud.net
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000

# --- Serving (Docker bind-mounts) ---
# Можно указать абсолютные пути к внешним каталогам на хосте:
# HOST_MODELS_DIR=C:/data/bank-rec/models
# HOST_SERVING_DATA_DIR=C:/data/bank-rec/serving
# HOST_CONFIGS_DIR=C:/data/bank-rec/configs
# HOST_MONITORING_DIR=C:/data/bank-rec/monitoring
HOST_MODELS_DIR=./models
HOST_SERVING_DATA_DIR=./data/serving
HOST_CONFIGS_DIR=./configs
HOST_MONITORING_DIR=./monitoring
API_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
